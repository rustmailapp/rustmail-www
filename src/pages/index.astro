---
import { Image } from "astro:assets";
import Layout from "../layouts/Layout.astro";
import logo from "../assets/logo.png";
import screenshotDark from "../assets/screenshot.png";
import screenshotLight from "../assets/screenshot-light.png";
import screenshotTui from "../assets/screenshot-tui.png";

const RELEASES_API =
  "https://api.github.com/repos/rustmailapp/rustmail/releases/latest";
const RELEASE_FETCH_TIMEOUT_MS = 5000;

async function fetchLatestReleaseTag(): Promise<string> {
  const token = process.env.GITHUB_TOKEN;
  const response = await fetch(RELEASES_API, {
    signal: AbortSignal.timeout(RELEASE_FETCH_TIMEOUT_MS),
    headers: {
      Accept: "application/vnd.github+json",
      ...(token ? { Authorization: `Bearer ${token}` } : {}),
    },
  });
  if (!response.ok) {
    throw new Error(
      `GitHub releases API answered ${response.status}; set GITHUB_TOKEN in the build environment if this is rate limiting`,
    );
  }
  const release: unknown = await response.json();
  const tag =
    typeof release === "object" && release !== null
      ? (release as Record<string, unknown>).tag_name
      : undefined;
  if (typeof tag !== "string" || tag.length === 0) {
    throw new Error("GitHub releases API answered without a tag_name string");
  }
  return tag;
}

let latestRelease: string | null = null;
try {
  latestRelease = await fetchLatestReleaseTag();
} catch (error) {
  console.warn(
    `Release badge omitted: ${error instanceof Error ? error.message : "unknown error"}`,
  );
}

const features = [
  {
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><ellipse cx="12" cy="5" rx="9" ry="3"/><path d="M3 5V19A9 3 0 0 0 21 19V5"/><path d="M3 12A9 3 0 0 0 21 12"/></svg>`,
    title: "Emails survive restarts",
    description:
      "SQLite-backed by default. Ephemeral mode for throwaway CI runs.",
  },
  {
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>`,
    title: "Find anything",
    description:
      "FTS5 full-text search across subject, body, sender, and recipients.",
  },
  {
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M13 2 3 14h9l-1 8 10-12h-9l1-8z"/></svg>`,
    title: "Real-time inbox",
    description:
      "WebSocket push. Dark mode. Keyboard shortcuts. Instant delivery.",
  },
  {
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M14.5 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7.5L14.5 2z"/><polyline points="14 2 14 8 20 8"/><path d="m9 15 2 2 4-4"/></svg>`,
    title: "Built for CI",
    description:
      "REST assertions, CLI assert mode, and a GitHub Action for your pipeline.",
  },
  {
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="m7.5 4.27 9 5.15"/><path d="M21 8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16Z"/><path d="m3.3 7 8.7 5 8.7-5"/><path d="M12 22V12"/></svg>`,
    title: "Single binary",
    description:
      "Frontend embedded at compile time. One binary, zero runtime dependencies.",
  },
  {
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="m18 16 4-4-4-4"/><path d="m6 8-4 4 4 4"/><path d="m14.5 4-5 16"/></svg>`,
    title: "REST API + OpenAPI",
    description:
      "Full API spec. Export emails, release to SMTP, webhook notifications.",
  },
];

---

<Layout>
  <div class="patina-layer" aria-hidden="true">
    <svg class="patina-oxide" preserveAspectRatio="xMidYMid slice" xmlns="http://www.w3.org/2000/svg">
      <defs>
        <filter id="oxide" x="0" y="0" width="100%" height="100%" color-interpolation-filters="sRGB">
          <feTurbulence type="fractalNoise" baseFrequency="0.011 0.019" numOctaves="5" seed="7" />
          <feColorMatrix
            type="matrix"
            values="1.15 0 0 0 0.15
                    0.46 0 0 0 0.04
                    0.09 0 0 0 0.01
                    0 0 0 0.85 -0.2"
          />
        </filter>
        <radialGradient id="oxide-falloff" cx="50%" cy="42%" r="78%">
          <stop offset="0%" stop-color="#000000" />
          <stop offset="48%" stop-color="#3a3a3a" />
          <stop offset="100%" stop-color="#ffffff" />
        </radialGradient>
        <mask id="oxide-mask">
          <rect width="100%" height="100%" fill="url(#oxide-falloff)" />
        </mask>
      </defs>
      <rect width="100%" height="100%" filter="url(#oxide)" mask="url(#oxide-mask)" />
    </svg>
    <div class="patina-flare"></div>
  </div>

  <div class="relative z-10">
    <!-- Nav -->
    <nav class="mx-auto flex max-w-6xl items-center justify-between px-6 py-6">
      <a href="/" class="flex items-center gap-3">
        <Image src={logo} alt="RustMail" width={32} height={32} densities={[1, 2]} loading="eager" class="size-8" />
        <span class="font-brand text-lg font-bold text-ink">RustMail</span>
      </a>
      <div class="flex items-center gap-4">
        <a
          href="https://docs.rustmail.app"
          class="text-sm text-ink-soft transition hover:text-ink"
        >
          Docs
        </a>
        <a
          href="https://github.com/rustmailapp/rustmail"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="RustMail on GitHub"
          class="inline-flex size-10 items-center justify-center rounded-lg border border-edge-strong bg-raised text-ink transition hover:border-ink-subtle hover:bg-edge"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/></svg>
        </a>
      </div>
    </nav>

    <!-- Hero -->
    <section class="mx-auto grid max-w-6xl items-center gap-12 px-6 pt-16 pb-24 md:grid-cols-[1.05fr_1fr] md:pt-24 md:pb-32">
      <div class="animate-fade-in-up">
        <p class="font-brand text-xs font-bold tracking-[0.22em] text-orange-500 uppercase">
          RustMail
        </p>
        <h1 class="mt-4 font-brand text-4xl leading-[1.08] font-bold tracking-tight text-balance text-ink md:text-5xl">
          Catch every email your app sends
        </h1>
        <p class="mt-5 max-w-lg text-lg leading-relaxed text-ink-muted">
          Nothing gets delivered &mdash; everything lands in a local web UI
          instead. An SMTP mail catcher for your dev and test environments.
          Single binary, nothing to install.
        </p>
        <div class="mt-9 flex flex-wrap items-center gap-4">
          <a
            href="https://docs.rustmail.app/getting-started/quick-start"
            class="btn-forged rounded-lg px-7 py-3 text-sm font-semibold text-zinc-950 transition"
          >
            Get Started
          </a>
          <a
            href="https://github.com/rustmailapp/rustmail"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 rounded-lg border border-edge-strong bg-raised px-7 py-3 text-sm font-semibold text-ink transition hover:border-ink-subtle hover:bg-edge"
          >
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/></svg>
            View on GitHub
          </a>
          {
            latestRelease && (
              <a
                href="https://github.com/rustmailapp/rustmail/releases/latest"
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-2 rounded-full border border-edge-strong px-3 py-1.5 font-mono text-xs text-ink-muted transition hover:border-ink-subtle hover:text-ink"
              >
                <span class="size-1.5 rounded-full bg-orange-500" />
                {latestRelease}
              </a>
            )
          }
        </div>
      </div>

      <!-- Terminal -->
      <div
        class="animate-scale-in overflow-hidden rounded-xl border border-edge bg-raised/80 text-left shadow-2xl backdrop-blur"
        style="animation-delay: 0.2s"
      >
        <div class="flex items-center gap-2 border-b border-edge px-4 py-3">
          <span class="size-3 rounded-full bg-edge-strong"></span>
          <span class="size-3 rounded-full bg-edge-strong"></span>
          <span class="size-3 rounded-full bg-edge-strong"></span>
          <span class="ml-3 text-xs text-ink-subtle">terminal</span>
        </div>
        <div class="p-5 font-mono text-sm leading-7">
          <p>
            <span class="text-ink-subtle">$</span>
            <span class="text-ink"> docker run -p 1025:1025 -p 8025:8025 smyile/rustmail:latest</span>
          </p>
          <p class="mt-2 text-ink-muted">
            SMTP listening on 0.0.0.0:1025
          </p>
          <p class="text-ink-muted">
            Web UI &rarr; <span class="text-orange-400">http://localhost:8025</span>
          </p>
        </div>
      </div>
    </section>

    <!-- Features -->
    <section class="mx-auto max-w-6xl px-6 py-24">
      <div class="mb-14 max-w-2xl">
        <h2 class="font-brand text-3xl font-bold text-balance text-ink md:text-4xl">
          Everything you need, nothing you don't
        </h2>
        <p class="mt-4 text-lg text-ink-muted">
          A self-hosted mail catcher that doesn't cut corners.
        </p>
      </div>
      <div class="grid border-t border-l border-edge sm:grid-cols-2 lg:grid-cols-3">
        {
          features.map((f) => (
            <div class="border-r border-b border-edge p-7 transition hover:bg-raised/60">
              <div class="mb-4 inline-flex text-orange-400">
                <Fragment set:html={f.icon} />
              </div>
              <h3 class="mb-2 text-base font-semibold text-ink">
                {f.title}
              </h3>
              <p class="text-sm leading-relaxed text-ink-muted">{f.description}</p>
            </div>
          ))
        }
      </div>
    </section>

    <!-- Screenshot: the one full-bleed band that breaks the column -->
    <section class="border-y border-edge bg-raised/70 py-24">
      <div class="mx-auto max-w-6xl px-6">
        <div class="mb-10 flex flex-wrap items-end justify-between gap-6">
          <div class="max-w-2xl">
            <h2 class="font-brand text-3xl font-bold text-balance text-ink md:text-4xl">
              See it in action
            </h2>
            <p class="mt-4 text-lg text-ink-muted">
              A UI that doesn't suck. Keyboard shortcuts, real-time updates, and
              a theme that follows yours.
            </p>
          </div>
          <div
            class="inline-flex shrink-0 rounded-lg border border-edge-strong bg-surface p-1"
            role="tablist"
            aria-label="Screenshot theme"
          >
            <button
              type="button"
              role="tab"
              id="shot-tab-dark"
              aria-controls="shot-panel-dark"
              aria-selected="true"
              data-shot="dark"
              class="shot-btn rounded-md px-4 py-1.5 text-sm font-medium transition"
            >
              Dark
            </button>
            <button
              type="button"
              role="tab"
              id="shot-tab-light"
              aria-controls="shot-panel-light"
              aria-selected="false"
              tabindex="-1"
              data-shot="light"
              class="shot-btn rounded-md px-4 py-1.5 text-sm font-medium transition"
            >
              Light
            </button>
          </div>
        </div>

        <div class="overflow-hidden rounded-xl border border-edge-strong shadow-2xl">
          <div id="shot-panel-dark" role="tabpanel" aria-labelledby="shot-tab-dark" data-shot-panel="dark">
            <Image
              src={screenshotDark}
              alt="RustMail web interface in dark mode showing the inbox with email details"
              widths={[1016, 2032]}
              sizes="(min-width: 1152px) 1088px, 100vw"
              class="w-full"
              loading="eager"
            />
          </div>
          <div id="shot-panel-light" role="tabpanel" aria-labelledby="shot-tab-light" data-shot-panel="light" hidden>
            <Image
              src={screenshotLight}
              alt="RustMail web interface in light mode showing the inbox with email details"
              widths={[1016, 2032]}
              sizes="(min-width: 1152px) 1088px, 100vw"
              class="w-full"
              loading="lazy"
            />
          </div>
        </div>

        <div class="mt-16 grid gap-8 md:grid-cols-[1fr_1.6fr] md:items-center">
          <div>
            <h3 class="font-brand text-xl font-bold text-ink">
              Or stay in the terminal
            </h3>
            <p class="mt-3 text-sm leading-relaxed text-ink-muted">
              The same inbox, the same search, without leaving your shell.
            </p>
          </div>
          <div class="overflow-hidden rounded-xl border border-edge">
            <Image
              src={screenshotTui}
              alt="RustMail terminal UI showing the inbox with email preview"
              widths={[672, 1344]}
              sizes="(min-width: 768px) 672px, 100vw"
              class="w-full"
              loading="lazy"
            />
          </div>
        </div>
      </div>
    </section>

    <!-- Install -->
    <section class="mx-auto max-w-4xl px-6 py-24">
      <div class="mb-12 max-w-2xl">
        <h2 class="font-brand text-3xl font-bold text-balance text-ink md:text-4xl">
          Get started in seconds
        </h2>
      </div>
      <div class="flex flex-col gap-3">
        {[
          { label: "Docker", cmd: "docker run -p 1025:1025 -p 8025:8025 smyile/rustmail:latest" },
          { label: "Homebrew", cmd: "brew install rustmailapp/rustmail/rustmail" },
          { label: "Binaries", cmd: "https://github.com/rustmailapp/rustmail/releases/latest" },
        ].map(({ label, cmd }) => (
          <div class="group flex items-center gap-4 rounded-xl border border-edge bg-raised px-5 py-4">
            <span class="w-20 shrink-0 text-xs font-medium tracking-wider text-ink-subtle uppercase">{label}</span>
            <code class="min-w-0 flex-1 overflow-x-auto font-mono text-sm whitespace-nowrap text-ink">{cmd}</code>
            <button
              data-cmd={cmd}
              class="copy-btn shrink-0 rounded-md p-1.5 text-ink-subtle transition hover:bg-edge hover:text-ink"
              aria-label={`Copy ${label}`}
            >
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="14" height="14" x="8" y="8" rx="2" ry="2"/><path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"/></svg>
            </button>
          </div>
        ))}
      </div>
    </section>

    <!-- CTA -->
    <section class="mx-auto max-w-3xl px-6 py-24 text-center">
      <h2 class="font-brand text-3xl font-bold text-balance text-ink md:text-4xl">
        Ready to catch some emails?
      </h2>
      <p class="mt-4 text-lg text-ink-muted">
        Open source, dual-licensed (MIT / Apache 2.0), free forever.
      </p>
      <div class="mt-10 flex flex-col items-center justify-center gap-4 sm:flex-row">
        <a
          href="https://docs.rustmail.app/getting-started/quick-start"
          class="btn-forged rounded-lg px-7 py-3 text-sm font-semibold text-zinc-950 transition"
        >
          Get Started
        </a>
        <a
          href="https://docs.rustmail.app"
          class="rounded-lg border border-edge-strong bg-raised px-7 py-3 text-sm font-semibold text-ink transition hover:border-ink-subtle hover:bg-edge"
        >
          Read the Docs
        </a>
      </div>
    </section>

    <!-- Footer -->
    <footer class="border-t border-edge py-12">
      <div class="mx-auto flex max-w-6xl flex-col items-center justify-between gap-4 px-6 sm:flex-row">
        <div class="flex items-center gap-2">
          <Image src={logo} alt="" width={20} height={20} densities={[1, 2]} class="size-5" />
          <span class="text-sm text-ink-muted">
            RustMail &mdash; MIT / Apache 2.0
          </span>
        </div>
        <div class="flex gap-6 text-sm text-ink-muted">
          <a href="https://docs.rustmail.app" class="transition hover:text-ink">Docs</a>
          <a href="https://github.com/rustmailapp/rustmail" target="_blank" rel="noopener noreferrer" class="transition hover:text-ink">GitHub</a>
          <a href="https://github.com/rustmailapp/rustmail/releases" target="_blank" rel="noopener noreferrer" class="transition hover:text-ink">Releases</a>
        </div>
      </div>
    </footer>
  </div>
</Layout>

<script type="module" src="/copy.js"></script>
<script type="module" src="/shot-toggle.js"></script>
