---
import { Image } from "astro:assets";
import Layout from "../layouts/Layout.astro";
import Patina from "../components/Patina.astro";
import SiteFooter from "../components/SiteFooter.astro";
import SiteNav from "../components/SiteNav.astro";
import { BENCHMARKS_URL, bars, difference, landingMetrics } from "../data/benchmarks";
import { copyIcon, githubIcon } from "../data/icons";
import screenshotDark from "../assets/screenshot.png";
import screenshotLight from "../assets/screenshot-light.png";
import screenshotTui from "../assets/screenshot-tui.png";

const DOCKER_CMD = "docker run -p 1025:1025 -p 8025:8025 smyile/rustmail:latest";
const ACTION_URL = "https://github.com/marketplace/actions/rustmail-action";

const features = [
  {
    title: "Flags links that break outside dev",
    description:
      "The details rail lists every link in the message and flags plain HTTP and localhost URLs before the mail reaches real users.",
  },
  {
    title: "DKIM, SPF and DMARC results",
    description:
      "Authentication-Results, DKIM-Signature, Received-SPF and ARC headers, parsed into a verdict badge per check.",
  },
  {
    title: "Phone-width preview",
    description:
      "Render the HTML at desktop width or in a 375px frame to see how a responsive template collapses.",
  },
  {
    title: "Emails survive restarts",
    description:
      "SQLite-backed by default, or in memory with --ephemeral for throwaway CI runs.",
  },
  {
    title: "Full-text search",
    description: "SQLite FTS5 across subject, body, sender, and recipients.",
  },
  {
    title: "REST API, webhooks and export",
    description:
      "An OpenAPI-documented REST API, a webhook on every new message, EML or JSON export, and release to a real SMTP server.",
  },
];

const ciExamples = [
  {
    id: "action",
    label: "GitHub Action",
    code: `- uses: rustmailapp/rustmail-action@v1

- run: npm test

- uses: rustmailapp/rustmail-action@v1
  with:
    mode: assert
    assert-count: 1
    assert-subject: "Welcome"`,
  },
  {
    id: "cli",
    label: "CLI",
    code: `rustmail assert --timeout=60s --min-count=2 --subject="Password Reset"`,
  },
  {
    id: "rest",
    label: "REST",
    code: `curl -f "localhost:8025/api/v1/assert/count?min=1&subject=Welcome"`,
  },
];

const installs = [
  { label: "Docker", cmd: DOCKER_CMD },
  { label: "Homebrew", cmd: "brew install rustmailapp/rustmail/rustmail" },
];

const linkClass = "text-ink underline decoration-edge-strong underline-offset-4 transition hover:decoration-ink";
---

<Layout>
  <Patina />

  <div class="relative z-10">
    <SiteNav />

    <main>
      <!-- Hero -->
      <section class="mx-auto grid max-w-6xl items-center gap-12 px-6 pt-12 pb-16 md:grid-cols-[1.05fr_1fr] md:pt-20 md:pb-20">
        <div class="animate-fade-in-up">
          <h1 class="font-brand text-4xl leading-[1.08] font-bold tracking-tight text-balance text-ink md:text-5xl">
            Catch every email your app sends
          </h1>
          <p class="mt-5 max-w-lg text-lg leading-relaxed text-ink-muted">
            Nothing gets delivered. Point your app's SMTP at{" "}
            <code class="font-mono text-base text-ink">localhost:1025</code>{" "}
            and every message lands in a web UI on{" "}
            <code class="font-mono text-base text-ink">localhost:8025</code>{" "}
            instead. An SMTP mail catcher for dev and CI, in one binary.
          </p>
          <div class="mt-9 flex flex-wrap items-center gap-4">
            <a
              href="https://docs.rustmail.app/getting-started/quick-start"
              class="btn-forged rounded-lg px-7 py-3 text-sm font-semibold text-surface transition"
            >
              Get Started
            </a>
            <a
              href="https://github.com/rustmailapp/rustmail"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 rounded-lg border border-edge-strong bg-raised px-7 py-3 text-sm font-semibold text-ink transition hover:border-ink-subtle hover:bg-edge"
            >
              <Fragment set:html={githubIcon} />
              View on GitHub
            </a>
            <a
              href="https://github.com/rustmailapp/rustmail/releases/latest"
              target="_blank"
              rel="noopener noreferrer"
              hidden
              data-release-badge
              class="inline-flex min-h-11 items-center gap-2 rounded-full border border-edge-strong px-4 font-mono text-xs text-ink-muted transition hover:border-ink-subtle hover:text-ink"
            >
              <span class="size-1.5 rounded-full bg-orange-500" />
              <span data-release-tag></span>
            </a>
          </div>
        </div>

        <!-- Terminal -->
        <div
          class="animate-scale-in overflow-hidden rounded-xl border border-edge bg-raised/80 text-left shadow-2xl backdrop-blur"
          style="animation-delay: 0.2s"
        >
          <div class="flex items-center gap-2 border-b border-edge py-1 pr-1 pl-4">
            <span class="size-3 rounded-full bg-edge-strong"></span>
            <span class="size-3 rounded-full bg-edge-strong"></span>
            <span class="size-3 rounded-full bg-edge-strong"></span>
            <span class="ml-3 flex-1 text-xs text-ink-subtle">terminal</span>
            <button
              type="button"
              data-cmd={DOCKER_CMD}
              class="copy-btn inline-flex size-11 items-center justify-center rounded-md text-ink-subtle transition hover:bg-edge hover:text-ink"
              aria-label="Copy the docker run command"
            >
              <Fragment set:html={copyIcon} />
            </button>
          </div>
          <div class="p-5 font-mono text-sm leading-7">
            <p class="text-ink">
              <span class="text-ink-subtle">$</span> docker run \<br />
              <span class="pl-8">-p 1025:1025 -p 8025:8025 \</span><br />
              <span class="pl-8">smyile/rustmail:latest</span>
            </p>
            <p class="mt-2 text-ink-muted">
              <span class="text-ink-subtle">INFO</span> HTTP server listening port=<span class="text-orange-400">8025</span>
            </p>
            <p class="text-ink-muted">
              <span class="text-ink-subtle">INFO</span> SMTP server listening addr=0.0.0.0:<span class="text-orange-400">1025</span>
            </p>
          </div>
        </div>
      </section>

      <!-- Screenshot: the one full-bleed band that breaks the column -->
      <section class="border-y border-edge bg-raised/70 py-20">
        <div class="mx-auto max-w-6xl px-6">
          <div class="mb-10 flex flex-wrap items-end justify-between gap-6">
            <div class="max-w-2xl">
              <h2 class="font-brand text-3xl font-bold text-balance text-ink md:text-4xl">
                Inspect every message in the web UI
              </h2>
              <p class="mt-4 text-lg text-ink-muted">
                Inbox, message and a details rail with auth results,
                attachments and links. New mail appears over WebSocket the
                moment it arrives, with vim-style keys to move, search and
                delete. Five palettes, dark or light.
              </p>
            </div>
            <div
              class="inline-flex shrink-0 rounded-lg border border-edge-strong bg-surface p-1"
              role="tablist"
              aria-label="Screenshot theme"
            >
              <button
                type="button"
                role="tab"
                id="shot-tab-dark"
                aria-controls="shot-panel-dark"
                aria-selected="true"
                class="tab-btn min-h-11 rounded-md px-4 text-sm font-medium transition"
              >
                Dark
              </button>
              <button
                type="button"
                role="tab"
                id="shot-tab-light"
                aria-controls="shot-panel-light"
                aria-selected="false"
                tabindex="-1"
                class="tab-btn min-h-11 rounded-md px-4 text-sm font-medium transition"
              >
                Light
              </button>
            </div>
          </div>

          <div>
            <div id="shot-panel-dark" role="tabpanel" aria-labelledby="shot-tab-dark">
              <Image
                src={screenshotDark}
                alt="RustMail web UI in dark mode: the inbox, an HTML email in desktop preview, and the details rail listing its links"
                widths={[1016, 2032]}
                sizes="(min-width: 1152px) 1088px, 100vw"
                class="w-full"
                loading="eager"
              />
            </div>
            <div id="shot-panel-light" role="tabpanel" aria-labelledby="shot-tab-light" hidden>
              <Image
                src={screenshotLight}
                alt="RustMail web UI in light mode: the inbox, an HTML email in desktop preview, and the details rail listing its links"
                widths={[1016, 2032]}
                sizes="(min-width: 1152px) 1088px, 100vw"
                class="w-full"
                loading="lazy"
              />
            </div>
          </div>

          <div class="mt-16 grid gap-8 md:grid-cols-[1fr_1.6fr] md:items-center">
            <div>
              <h3 class="font-brand text-xl font-bold text-ink">
                Or stay in the terminal
              </h3>
              <p class="mt-3 text-sm leading-relaxed text-ink-muted">
                <code class="font-mono text-ink">rustmail tui</code> connects to a
                running server: the same inbox and search, with vim-style keys. It
                ships in the pre-built binaries (not the Docker image) and as a{" "}
                <a href="https://docs.rustmail.app/integrations/neovim" class={linkClass}>Neovim plugin</a>.
              </p>
            </div>
            <div>
              <Image
                src={screenshotTui}
                alt="RustMail terminal UI showing the inbox with email preview"
                widths={[672, 1344]}
                sizes="(min-width: 768px) 672px, 100vw"
                class="w-full"
                loading="lazy"
              />
            </div>
          </div>
        </div>
      </section>

      <!-- Features -->
      <section class="mx-auto max-w-6xl px-6 py-24">
        <div class="mb-12 max-w-2xl">
          <h2 class="font-brand text-3xl font-bold text-balance text-ink md:text-4xl">
            Features for local email testing
          </h2>
          <p class="mt-4 text-lg text-ink-muted">
            What RustMail checks and keeps for every message it catches.
          </p>
        </div>
        <dl class="grid gap-x-12 sm:grid-cols-2">
          {
            features.map((f) => (
              <div class="border-t border-edge py-6">
                <dt class="text-base font-semibold text-ink">{f.title}</dt>
                <dd class="mt-2 max-w-prose text-sm leading-relaxed text-pretty text-ink-muted">{f.description}</dd>
              </div>
            ))
          }
        </dl>
      </section>

      <!-- CI -->
      <section class="mx-auto max-w-6xl px-6 pb-24">
        <div class="grid gap-10 md:grid-cols-[1fr_1.4fr] md:items-start">
          <div>
            <h2 class="font-brand text-3xl font-bold text-balance text-ink md:text-4xl">
              Test emails in CI
            </h2>
            <p class="mt-4 text-lg text-ink-muted">
              Fail the build when an email is missing or wrong. Start RustMail
              with the GitHub Action, wait with{" "}
              <code class="font-mono text-base text-ink">rustmail assert</code>,
              or check a running server with one{" "}
              <code class="font-mono text-base text-ink">curl</code>.
            </p>
            <p class="mt-6 flex flex-col gap-2 text-sm">
              <a href={ACTION_URL} target="_blank" rel="noopener noreferrer" class={`self-start ${linkClass}`}>
                RustMail Action on the GitHub Marketplace
              </a>
              <a href="https://docs.rustmail.app/ci-integration/github-action" class={`self-start ${linkClass}`}>
                CI integration guide
              </a>
            </p>
          </div>
          <div class="min-w-0 overflow-hidden rounded-xl border border-edge-strong bg-raised">
            <div class="flex border-b border-edge p-1" role="tablist" aria-label="CI example">
              {
                ciExamples.map((example, i) => (
                  <button
                    type="button"
                    role="tab"
                    id={`ci-tab-${example.id}`}
                    aria-controls={`ci-panel-${example.id}`}
                    aria-selected={i === 0 ? "true" : "false"}
                    tabindex={i === 0 ? undefined : "-1"}
                    class="tab-btn min-h-11 rounded-md px-4 text-sm font-medium transition"
                  >
                    {example.label}
                  </button>
                ))
              }
            </div>
            {
              ciExamples.map((example, i) => (
                <div
                  id={`ci-panel-${example.id}`}
                  role="tabpanel"
                  aria-labelledby={`ci-tab-${example.id}`}
                  hidden={i !== 0}
                  class="flex items-start"
                >
                  <pre class="min-w-0 flex-1 overflow-x-auto p-5 font-mono text-sm leading-7 text-ink"><code>{example.code}</code></pre>
                  <button
                    type="button"
                    data-cmd={example.code}
                    class="copy-btn m-2 inline-flex size-11 shrink-0 items-center justify-center rounded-md text-ink-subtle transition hover:bg-edge hover:text-ink"
                    aria-label={`Copy the ${example.label} example`}
                  >
                    <Fragment set:html={copyIcon} />
                  </button>
                </div>
              ))
            }
          </div>
        </div>
      </section>

      <!-- Benchmarks -->
      <section class="mx-auto max-w-6xl px-6 pb-24" aria-labelledby="bench-title">
        <div class="mb-12 max-w-2xl">
          <h2 id="bench-title" class="font-brand text-3xl font-bold text-balance text-ink md:text-4xl">
            Fast where your tests wait
          </h2>
          <p class="mt-4 text-lg text-ink-muted">
            All three in Docker, 100,000 messages stored. Shorter is better.
          </p>
        </div>
        <div class="grid gap-x-16 gap-y-10 md:grid-cols-2">
          {
            landingMetrics.map((metric) => (
              <figure>
                <figcaption class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
                  <span class="font-semibold text-ink">{metric.label}</span>
                  <span class="font-brand font-bold text-orange-400">
                    {difference(metric, "mailpit")} than Mailpit
                  </span>
                </figcaption>
                <dl class="mt-4 flex flex-col gap-3 text-sm">
                  {
                    bars(metric).map((bar) => (
                      <div class="grid grid-cols-[5.5rem_minmax(0,1fr)] items-center gap-3">
                        <dt class={bar.isRustmail ? "font-medium text-ink" : "text-ink-muted"}>{bar.name}</dt>
                        <dd class="flex items-center gap-3">
                          <span class="h-2.5 flex-1 overflow-hidden rounded-full bg-raised" aria-hidden="true">
                            <span
                              class={`block h-full rounded-full ${bar.isRustmail ? "bg-orange-400" : "bg-edge-strong"}`}
                              style={`width: ${bar.widthPercent}%`}
                            />
                          </span>
                          <span class="w-24 text-right font-mono text-xs text-ink-muted">{bar.text}</span>
                        </dd>
                      </div>
                    ))
                  }
                </dl>
              </figure>
            ))
          }
        </div>
        <p class="mt-10 max-w-3xl text-sm leading-relaxed text-ink-muted">
          Latencies are p50, median of at least 3 runs on an Apple M4 Pro. MailHog runs
          under amd64 emulation and keeps mail in memory only. See the{" "}
          <a href="/compare/#speed" class={linkClass}>full comparison</a> or the{" "}
          <a href={BENCHMARKS_URL} class={linkClass}>method and raw numbers</a>.
        </p>
      </section>

      <!-- Install -->
      <section class="mx-auto max-w-4xl px-6 pb-24">
        <div class="mb-12 max-w-2xl">
          <h2 class="font-brand text-3xl font-bold text-balance text-ink md:text-4xl">
            Install
          </h2>
          <p class="mt-4 text-lg text-ink-muted">
            Coming from MailHog or Mailpit? RustMail listens on the same
            default ports, SMTP 1025 and HTTP 8025, so your app's SMTP settings
            stay as they are. See how the three{" "}
            <a href="/compare/" class={linkClass}>compare</a>.
          </p>
        </div>
        <div class="flex flex-col gap-3">
          {installs.map(({ label, cmd }) => (
            <div class="grid grid-cols-[1fr_auto] items-center gap-x-4 rounded-xl border border-edge-strong bg-raised py-2 pr-2 pl-5 sm:grid-cols-[5rem_1fr_auto]">
              <span class="text-xs font-medium tracking-wider text-ink-subtle uppercase sm:col-start-1">{label}</span>
              <code class="col-span-2 row-start-2 min-w-0 pb-3 font-mono text-sm text-ink sm:col-span-1 sm:col-start-2 sm:row-start-1 sm:overflow-x-auto sm:pb-0 sm:whitespace-nowrap">{cmd}</code>
              <button
                type="button"
                data-cmd={cmd}
                class="copy-btn inline-flex size-11 items-center justify-center rounded-md text-ink-subtle transition hover:bg-edge hover:text-ink sm:col-start-3 sm:row-start-1"
                aria-label={`Copy the ${label} command`}
              >
                <Fragment set:html={copyIcon} />
              </button>
            </div>
          ))}
          <a
            href="https://github.com/rustmailapp/rustmail/releases/latest"
            target="_blank"
            rel="noopener noreferrer"
            class="group grid grid-cols-[1fr_auto] items-center gap-x-4 rounded-xl border border-edge-strong bg-raised py-2 pr-2 pl-5 transition hover:border-ink-subtle sm:grid-cols-[5rem_1fr_auto]"
          >
            <span class="text-xs font-medium tracking-wider text-ink-subtle uppercase sm:col-start-1">Binaries</span>
            <span class="col-span-2 row-start-2 min-w-0 pb-3 text-sm text-ink sm:col-span-1 sm:col-start-2 sm:row-start-1 sm:truncate sm:pb-0">
              Linux x86_64, aarch64 and armv7, macOS Intel and Apple Silicon
            </span>
            <span class="inline-flex size-11 items-center justify-center text-ink-subtle transition group-hover:text-ink sm:col-start-3 sm:row-start-1">
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M7 7h10v10"/><path d="M7 17 17 7"/></svg>
            </span>
          </a>
        </div>
      </section>

      <!-- CTA -->
      <section class="mx-auto max-w-3xl px-6 py-24 text-center">
        <h2 class="font-brand text-3xl font-bold text-balance text-ink md:text-4xl">
          Start catching email
        </h2>
        <p class="mt-4 text-lg text-ink-muted">
          Open source, dual-licensed MIT / Apache 2.0.
        </p>
        <div class="mt-10 flex flex-col items-center justify-center gap-4 sm:flex-row">
          <a
            href="https://docs.rustmail.app/getting-started/quick-start"
            class="btn-forged rounded-lg px-7 py-3 text-sm font-semibold text-surface transition"
          >
            Get Started
          </a>
          <a
            href={ACTION_URL}
            target="_blank"
            rel="noopener noreferrer"
            class="rounded-lg border border-edge-strong bg-raised px-7 py-3 text-sm font-semibold text-ink transition hover:border-ink-subtle hover:bg-edge"
          >
            Add the GitHub Action
          </a>
        </div>
      </section>
    </main>

    <SiteFooter />
  </div>
</Layout>

<script type="module" src="/copy.js"></script>
<script type="module" src="/tabs.js"></script>
<script type="module" src="/release-badge.js"></script>
